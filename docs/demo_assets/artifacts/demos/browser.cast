[1.0340528829983668, "o", "SENSAI | BROWSER\nActual component execution; fictional Atelier Nova data."]
[1.0340686669987917, "o", "\n"]
[2.718639840997639, "o", "\n\u001b[36m>>> browser_navigate: open the local cart page\u001b[0m"]
[2.7186594669983606, "o", "\n"]
[2.7661864449983113, "o", "URL: http://127.0.0.1:41999/\nTitle: Atelier Nova \u2014 Cart check\n\n- main [ref=e2]:\n  - heading \"Atelier Nova\" [level=1] [ref=e3]\n  - heading \"Cart check\" [level=2] [ref=e4]\n  - generic [ref=e5]:\n    - text: Item prices\n    - textbox \"Item prices\" [ref=e6]: 10, 20\n    - button \"Calculate subtotal\" [ref=e7]\n  - status [ref=e8]: Enter prices to check the cart."]
[2.7662044639982923, "o", "\n"]
[3.56793131899758, "o", "\n\u001b[36m>>> browser_click: calculate 10 + 20\u001b[0m"]
[3.5679705000002286, "o", "\n"]
[3.599028229000396, "o", "URL: http://127.0.0.1:41999/\nTitle: Atelier Nova \u2014 Cart check\n\n- main [ref=e2]:\n  - heading \"Atelier Nova\" [level=1] [ref=e3]\n  - heading \"Cart check\" [level=2] [ref=e4]\n  - generic [ref=e5]:\n    - text: Item prices\n    - textbox \"Item prices\" [ref=e6]: 10, 20\n    - button \"Calculate subtotal\" [ref=e7]\n  - status [ref=e8]: \"Subtotal: 30\""]
[3.5990405209995515, "o", "\n"]
[4.400041503999091, "o", "\n\u001b[36m>>> browser_type: clear Item prices; browser_click: calculate\u001b[0m"]
[4.400062037999305, "o", "\n"]
[4.46389755799828, "o", "URL: http://127.0.0.1:41999/\nTitle: Atelier Nova \u2014 Cart check\n\n- main [ref=e2]:\n  - heading \"Atelier Nova\" [level=1] [ref=e3]\n  - heading \"Cart check\" [level=2] [ref=e4]\n  - generic [ref=e5]:\n    - text: Item prices\n    - textbox \"Item prices\" [ref=e6]\n    - button \"Calculate subtotal\" [ref=e7]\n  - status [ref=e8]: \"Subtotal: 0\""]
[4.463909361998958, "o", "\n"]
[5.2650572169986845, "o", "\n\u001b[36m>>> browser_type: invalid input produces a visible form error\u001b[0m"]
[5.265077400999871, "o", "\n"]
[5.313632099998358, "o", "URL: http://127.0.0.1:41999/\nTitle: Atelier Nova \u2014 Cart check\n\n- main [ref=e2]:\n  - heading \"Atelier Nova\" [level=1] [ref=e3]\n  - heading \"Cart check\" [level=2] [ref=e4]\n  - generic [ref=e5]:\n    - text: Item prices\n    - textbox \"Item prices\" [ref=e6]: invalid\n    - button \"Calculate subtotal\" [ref=e7]\n  - status [ref=e8]: \"Invalid prices: enter numbers separated by commas.\""]
[5.313643554000009, "o", "\n"]
[5.334869027999957, "image", "/home/eliott/SenseiUwuMirror/docs/assets/demos/browser-captured.png"]
[7.136964712997724, "o", "\n\u001b[36m>>> browser_navigate: file URLs are rejected\u001b[0m"]
