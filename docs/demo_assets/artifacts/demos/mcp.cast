{"version": 2, "width": 100, "height": 34, "title": "Sensai \u2014 mcp"}
[0.9913680499994371, "o", "SENSAI | MCP\nActual component execution; fictional Atelier Nova data."]
[0.9913837639978738, "o", "\n"]
[3.7948355929984245, "o", "\n\u001b[36m>>> /mcp add-json atelier: connect to the local read-only rule server\u001b[0m"]
[3.7948517259974324, "o", "\n"]
[3.8468742730001395, "o", "MCP connected: 1 tool(s) added.\n"]
[3.8469353139989835, "o", "{\n  \"discovered_tool\": \"cart_rule\"\n}"]
[3.8469419489993015, "o", "\n"]
[4.647916711001017, "o", "\n\u001b[36m>>> cart_rule: retrieve CART-EMPTY-001 over MCP\u001b[0m"]
[4.647934799999348, "o", "\n"]
[4.697441226999217, "o", "{\n  \"meta\": {\n    \"io.modelcontextprotocol/serverInfo\": {\n      \"name\": \"Atelier Nova demo\",\n      \"version\": \"\"\n    }\n  },\n  \"content\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"CART-EMPTY-001: An empty cart has subtotal 0.\"\n    }\n  ],\n  \"structured_content\": {\n    \"result\": \"CART-EMPTY-001: An empty cart has subtotal 0.\"\n  },\n  \"is_error\": false,\n  \"result_type\": \"complete\"\n}"]
[4.697452681000868, "o", "\n"]
[5.498506637999526, "o", "\n\u001b[36m>>> cart_rule: an unknown rule produces no invented requirement\u001b[0m"]
[5.498533457997837, "o", "\n"]
[5.502495510998415, "o", "{\n  \"meta\": {\n    \"io.modelcontextprotocol/serverInfo\": {\n      \"name\": \"Atelier Nova demo\",\n      \"version\": \"\"\n    }\n  },\n  \"content\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"Unknown cart rule. No result is available for this identifier.\"\n    }\n  ],\n  \"structured_content\": {\n    \"result\": \"Unknown cart rule. No result is available for this identifier.\"\n  },\n  \"is_error\": false,\n  \"result_type\": \"complete\"\n}"]
[5.502508850997401, "o", "\n"]
[6.303728677998151, "o", "\n\u001b[36m>>> Close the MCP connection and remove its tools\u001b[0m"]
[6.303749210997921, "o", "\n"]
[6.304701363998902, "o", "{\n  \"cart_rule_still_registered\": false\n}"]
[6.304709885000193, "o", "\n"]
[7.5206528210001125, "o", "\nComponent demonstration completed."]
[7.520667487999162, "o", "\n"]
